# Fișiere încărcate de utilizatori: interzicem execuția oricărui script.
<FilesMatch "\.(php\d?|phtml|phar|pht|phps|cgi|pl|py|sh|htaccess)$">
    Require all denied
</FilesMatch>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
Options -ExecCGI -Indexes
