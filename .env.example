# ============================================================================
# AUTENTIK MARKET — configurare mediu (copiați în .env și completați)
# Fișierul .env NU este niciodată suprascris de Update Manager.
# ============================================================================

APP_NAME="Autentik Market"
APP_ENV=production
APP_KEY=
# În producție: ÎNTOTDEAUNA false (nu expunem stack trace-uri)
APP_DEBUG=false
APP_URL=https://autentikmarket.ro
APP_TIMEZONE=Europe/Bucharest

APP_LOCALE=ro
APP_FALLBACK_LOCALE=ro
APP_FAKER_LOCALE=ro_RO

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Log-uri zilnice (storage/logs/laravel-YYYY-MM-DD.log)
LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# MySQL / MariaDB (cPanel → MySQL Databases)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_autentik
DB_USERNAME=cpaneluser_autentik
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Sesiuni securizate
SESSION_DRIVER=database
SESSION_LIFETIME=240
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Coadă: database (fără Supervisor) — procesată de scheduler (vezi docs/CRON.md)
QUEUE_CONNECTION=database

# Cache: database (Redis NU este necesar)
CACHE_STORE=database
CACHE_PREFIX=am_

# E-mail: cont cPanel (ex. noreply@autentikmarket.ro) sau SMTP extern
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.autentikmarket.ro
MAIL_PORT=465
MAIL_USERNAME=noreply@autentikmarket.ro
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@autentikmarket.ro"
MAIL_FROM_NAME="Autentik Market"

# Rezervări standuri
STAND_HOLD_MINUTES=15

# Update Manager
UPDATE_MAX_PACKAGE_MB=200
UPDATE_MIN_FREE_DISK_MB=200
UPDATE_BACKUP_DATABASE=true
UPDATE_KEEP_BACKUPS=5
# Cheia PUBLICĂ Ed25519 (base64) pentru verificarea semnăturii pachetelor (php artisan update:keygen)
UPDATE_PUBLIC_KEY=
UPDATE_REQUIRE_SIGNATURE=false

VITE_APP_NAME="${APP_NAME}"
