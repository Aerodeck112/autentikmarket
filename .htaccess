# ---------------------------------------------------------------------------
# Autentik Market — .htaccess RĂDĂCINĂ (varianta de rezervă pentru cPanel)
#
# Varianta RECOMANDATĂ: document root-ul domeniului indică direct /public
# (cPanel → Domains → Document Root). În acest caz fișierul de față nu este folosit.
#
# Dacă document root-ul NU poate fi schimbat și aplicația este urcată direct în
# public_html, acest fișier redirecționează totul către /public și blochează
# accesul la restul directoarelor (app, config, storage, vendor, .env …).
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Blochează fișierele ascunse (.env, .git …), cu excepția .well-known (AutoSSL)
    RewriteRule (^|/)\.(?!well-known/) - [F,L]

    # /index.php în față → adresa curată (adresele /public/… sunt tratate în public/.htaccess)
    RewriteCond %{THE_REQUEST} \s/+index\.php[\s?/] [NC]
    RewriteRule ^index\.php/?(.*)$ /$1 [R=301,L,NE]

    # Codul aplicației nu este accesibil din web.
    # NU blocăm /storage/: adresele /storage/… sunt fișierele publice încărcate (public/storage),
    # iar regula finală le trimite în public/, deci storage/ din rădăcină (loguri, documente) rămâne inaccesibil.
    RewriteRule ^(app|bootstrap|config|database|lang|resources|routes|tests|vendor|node_modules|releases|docs)(/|$) - [F,L]
    RewriteRule ^(artisan|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|vite\.config\.js|VERSION|README\.md)$ - [F,L]

    # Tot restul → public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

Options -Indexes
